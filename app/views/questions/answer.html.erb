<div class="container mt-5">
  <h1 class="mb-4">Stupid Coaching</h1>

  <div class="p-3 mb-3 bg-light border-start border-4 border-secondary">
    <p class="mb-1 fs-5"><%= @question %></p>
    <small class="text-muted font-monospace fst-italic">-You</small>
  </div>

  <div class="p-3 mb-4 bg-warning bg-opacity-10 border-start border-4 border-warning">
    <p class="mb-1 fs-5 text-dark"><%= @answer %></p>
    <small class="text-muted font-monospace fst-italic">-Your coach</small>
  </div>

  <%= link_to "Ask a new question", ask_path, class: "text-decoration-none" %>
</div>
